{
  "name": "devpocket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.1",
  "workspaces": [
    "packages/components"
  ],
  "engines": {
    "node": ">=26.12.1 <27",
    "npm": ">=12.2.1 <13"
  },
  "scripts": {
    "build": "npm run build --workspace @devpocket/components && tsc -p backend/tsconfig.json && node scripts/bundle-extension.mjs",
    "package:extension": "npm run build && pwsh -NoProfile -File scripts/package-extension.ps1",
    "test:extension-package": "npm run build && node --test scripts/tests/extension-package.test.mjs",
    "test:setup": "npm run build && node --import tsx --test deployment/onboarding/tests/setup*.test.mjs && python -B -m unittest discover -s deployment/onboarding/tests -p setup_guest_test.py",
    "typecheck": "npm run build --workspace @devpocket/components && tsc -p backend/tsconfig.json --noEmit && tsc -p backend/tsconfig.cli-proof.json",
    "test": "npm test --workspace @devpocket/components && node --import tsx --test backend/tests/*.test.ts",
    "verify": "pwsh -NoProfile -File scripts/verify.ps1",
    "test:tooling": "node scripts/test-tooling.mjs",
    "emulator:status": "node scripts/emulator-resources.mjs status",
    "emulator:limit": "node scripts/emulator-resources.mjs limit",
    "test:android": "pwsh -NoProfile -File scripts/test-android.ps1",
    "test:operations": "npm run build && node --import tsx --test deployment/onboarding/tests/*.test.mjs && python -B -m unittest discover -s deployment/azure/tests -p vm_test.py && python -B -m unittest discover -s deployment/azure/probe -p test_receiver.py && python -B -m unittest discover -s deployment/azure/real -p test_real.py",
    "relay": "node dist/cli.js relay",
    "host": "node dist/cli.js host",
    "pair": "node dist/cli.js pair",
    "devices": "node dist/cli.js devices",
    "revoke": "node dist/cli.js revoke",
    "schema": "node --import tsx scripts/export-schema.ts",
    "test:cli:start": "node --import tsx backend/integration/canvas-proof.ts start",
    "test:cli:proof": "node --import tsx backend/integration/canvas-proof.ts",
    "test:cli:harness": "node --import tsx --test backend/tests/cli-proof*.test.ts backend/tests/local-proof.test.ts",
    "test:cli": "node --import tsx backend/integration/live-checks.ts",
    "test:cli:cancel": "node --import tsx backend/integration/cancel-check.ts"
  },
  "dependencies": {
    "@devpocket/components": "file:packages/components",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}

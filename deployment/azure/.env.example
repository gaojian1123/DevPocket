# Placeholder-only contract. Put real values in the project-local azd environment,
# never in source. Tenant and subscription must be explicitly confirmed.
AZURE_ENV_NAME=devpocket-REPLACE
AZURE_TENANT_ID=REPLACE_WITH_CONFIRMED_TENANT_UUID
AZURE_SUBSCRIPTION_ID=REPLACE_WITH_CONFIRMED_SUBSCRIPTION_UUID
AZURE_LOCATION=REPLACE_WITH_CONFIRMED_AZURE_REGION
AZURE_RESOURCE_GROUP=rg-devpocket-REPLACE
DEVPOCKET_DEPLOYMENT_ID=REPLACE_WITH_NEW_INDEPENDENT_UUID
DEVPOCKET_DEPLOYER_OBJECT_ID=REPLACE_WITH_OBJECT_ID_IN_SELECTED_TENANT
DEVPOCKET_VM_SIZE=REPLACE_WITH_APPROVED_X64_SIZE
DEVPOCKET_DATA_DISK_GIB=32
DEVPOCKET_DNS_LABEL=devpocket-REPLACE
# Empty means use the actual Azure-assigned Public IP FQDN.
DEVPOCKET_DOMAIN=
DEVPOCKET_TLS_EMAIL=REPLACE_WITH_CONFIRMED_ACME_EMAIL
# Explicit public NAT/proxy egress address for Blob uploads, not a private address.
DEVPOCKET_UPLOAD_IPV4=REPLACE_WITH_APPROVED_PUBLIC_IPV4
# Public RSA key only. Keep the private key outside source and outside azd outputs.
DEVPOCKET_SSH_PUBLIC_KEY=REPLACE_WITH_PUBLIC_RSA_KEY
# Application autostart on this NEW VM only; never on a Dev Box. Opt in separately.
DEVPOCKET_VM_AUTOSTART=false

{
    email {$DEVPOCKET_ACME_EMAIL}
    admin off
}

{$DEVPOCKET_DOMAIN} {
    request_body {
        max_size 3MB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    reverse_proxy 127.0.0.1:8787 {
        header_up X-Forwarded-Proto https
    }
}

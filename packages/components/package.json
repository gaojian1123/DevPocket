{
  "name": "@devpocket/components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/spec.d.ts",
      "default": "./dist/spec.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=26.12.1 <27",
    "npm": ">=12.2.1 <13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "chart.js": "4.6.1",
    "markdown-it": "15.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}

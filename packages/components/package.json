{
  "name": "@devpocket/components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/spec.d.ts",
      "default": "./dist/spec.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "markdown-it": "14.3.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.0.10",
    "esbuild": "0.25.5",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
